# Twilio Credentials
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# OpenAI API Key
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Cal.com API Key
# Get this from: https://app.cal.com/settings/developer/api-keys
CAL_API_KEY=cal_live_your_cal_api_key_here
CAL_EVENT_TYPE=free-consultation

# Notion Integration
# Get these from: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# CRM Backend Integration
# Configure your CRM backend public endpoint and tenant code
CRM_BACKEND_URL=https://crm-backend-8b97.onrender.com
CRM_TENANT_CODE=walmart

# Multi-Tenant Registry (optional but recommended for production)
# MASTER_NOVA_API_KEY: authenticates Nova against GET /public/tenant-registry/
#   on the CRM backend.  When set, Nova fetches per-tenant API keys and signing
#   secrets at startup and uses them for HMAC-authenticated CRM requests.
#   Leave blank to run in single-tenant mode using CRM_TENANT_CODE above.
MASTER_NOVA_API_KEY=
# How often Nova refreshes the tenant registry in the background (seconds).
REGISTRY_SYNC_INTERVAL=3600

# Server Config (usually don't need to change these)
HOST=0.0.0.0
PORT=8000

# Webhook Security (Optional - leave empty to disable signature validation)
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
